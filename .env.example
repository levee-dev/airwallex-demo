# Acme Pay configuration. Copy to .env (`npm run dev` offers to do it for you); the server, `npm run dev`,
# `npm run setup` and `npm run db:migrate` read it.
# Never commit .env.

# --- Required ---------------------------------------------------------------

# Postgres connection string. Matches docker-compose.yml.
DATABASE_URL=postgres://acme:acme@localhost:5432/acme

# 32 random bytes, base64. Encrypts the stored Levee and Airwallex credentials and agent keys.
# Generate with: openssl rand -base64 32
ACME_ENCRYPTION_KEY=

# --- App --------------------------------------------------------------------

# The browser origin of the web app (no path). Approval links, the MCP URL, the webhook URL and
# passkey origins derive from it. Must be https, except http on localhost. Default below.
# In production the server serves the web app itself, so use the server's public origin.
# `npm run dev` replaces it for the run with its Cloudflare quick tunnel origin (unless --no-tunnel).
ACME_PUBLIC_URL=http://localhost:5173

# Optional. The passkey relying party (RP) ID `npm run setup` sets on the Levee tenant. Defaults to
# the host of ACME_PUBLIC_URL. Set it to a parent domain of that host (for https://pay.example.com,
# example.com) to share passkeys across subdomains. It must be the host or a registrable suffix of
# it; changing it later makes existing passkeys stop working, so setup asks first.
# ACME_PASSKEY_RP_ID=

# Where the API server listens. Defaults: 127.0.0.1 and 8787.
HOST=127.0.0.1
PORT=8787

# "production" serves the built web app from the server and requires https Levee origins.
NODE_ENV=development

# "true" when the server sits behind a reverse proxy, so client addresses come from X-Forwarded-For
# (used for rate limits). Default false.
TRUST_PROXY=false

# --- Levee ------------------------------------------------------------------

# Levee API origin. Default https://sandbox.levee.dev.
LEVEE_API_URL=https://sandbox.levee.dev

# Origin Acme presents to Levee with its CSRF token on unsafe calls. Defaults to LEVEE_API_URL.
# LEVEE_CONSOLE_ORIGIN=https://sandbox.levee.dev

# --- Airwallex --------------------------------------------------------------

# Airwallex API origin. Must be a sandbox host: https://api-demo.airwallex.com (default)
# or https://api.sandbox.airwallex.com.
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com

# --- `npm run setup` (optional) ---------------------------------------------
# `npm run setup` and the first `npm run dev` prompt for anything not set here. Set them to run
# unattended (for example in CI). They are only read at setup, which verifies them and stores them
# encrypted in the database. `npm run dev` registers its own webhook endpoint, so it does not need
# the webhook secret; real deployments do.

# ACME_SETUP_LEVEE_TENANT_ID=ten_...
# ACME_SETUP_LEVEE_PLATFORM_KEY=sk_test_...
# ACME_SETUP_LEVEE_WEBHOOK_SECRET=whsec_...
# ACME_SETUP_AIRWALLEX_CLIENT_ID=
# ACME_SETUP_AIRWALLEX_API_KEY=

# --- Decision model (optional) ----------------------------------------------
# An optional model that can stop or narrow a mandate request before it reaches Levee. It never
# approves anything. Off unless SYSTEM_ONE_API_KEY is set; then BASE_URL and MODEL are required.

# SYSTEM_ONE_API_KEY=
# SYSTEM_ONE_BASE_URL=https://models.example.com
# SYSTEM_ONE_MODEL=
# Request timeout in milliseconds, 100 to 15000. Default 4000.
# SYSTEM_ONE_TIMEOUT_MS=4000

# --- Development and tests (read from your shell, not from this file) -------

# Where the Vite dev server proxies /api, /mcp and /webhooks. Default http://127.0.0.1:8787.
# ACME_SERVER_URL=http://127.0.0.1:8787

# A Postgres server where the user may create databases. When reachable, `npm test` also runs the
# integration suite, which creates and drops its own database there.
# TEST_DATABASE_URL=postgres://acme:acme@localhost:5432/postgres
